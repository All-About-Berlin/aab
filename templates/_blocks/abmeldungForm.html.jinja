<collapsible class="abmeldung-form" {% if static|default %}static{% endif %} v-cloak>
	<template v-slot:header>
		<small>Abmeldung</small>
		{% trans %}Deregister your address{% endtrans %}
	</template>
	<progress v-if="stage !== 'start'" aria-label="{% trans "Label for the progress bar on a multi-step form" %}Form progress{% endtrans %}" :max="stages.length - 1" :value="stageIndex"></progress>
	<template v-if="stage === 'start'">
		{% image 'documents/abmeldung-original.pdf', alt="German document preview", sizes="300px" %}
		<p>{% trans %}This tool helps you <strong>fill the <glossary>Abmeldung</glossary> form</strong> in 3 minutes. You can save the completed form, print it, and bring it to your <glossary>Bürgeramt</glossary> appointment.{% endtrans %}</p>
		<p>{% trans %}Your personal information stays on your computer. No one else can see it.{% endtrans %}</p>
	</template>
	<template v-if="stage === 'oldAddress'">
		<h2>{% trans %}Your old address{% endtrans %}</h2>
		<p>{% trans %}Where did you live? Enter the address that you want to deregister.{% endtrans %}</p>
		<hr>
		<div class="form-group required">
			<label :for="uid('oldAddress')">{% trans "The first line of an address" %}Street address{% endtrans %}</label>
			<input
				:id="uid('oldAddress')"
				ref="oldAddressInput"
				type="text"
				v-model="oldAddress"
				placeholder="Alte Straße 123"
				autocomplete="address-line1"
				required>
		</div>
		<div class="form-group required">
			<label :for="uid('oldPostCode')">
				<glossary term="Postleitzahl">{% trans %}Post code{% endtrans %}</glossary>
			</label>
			<div class="input-group">
				<postalcode-input ref="oldPostCodeInput" :id="uid('oldPostCode')" v-model="oldPostCode" required></postalcode-input>
				{% trans %}Berlin{% endtrans %}
			</div>
		</div>
		<div class="form-group">
			<label :for="uid('oldBuildingDetails')">{% trans "For example, 'Haus B, 2. Etage rechts'" %}Building details{% endtrans %}</label>
			<input
				:id="uid('oldBuildingDetails')"
				type="text"
				v-model="oldBuildingDetails"
				placeholder="Haus B, 2. Etage rechts"
				autocomplete="address-line2">
			<a class="input-instructions internal-link" href="/guides/addressing-a-letter-in-germany#extra-information" target="_blank">{% trans %}How to write your building details{% endtrans %}</a>
		</div>
		<hr>
		<div class="form-group required">
			<label :for="uid('moveOutDate') + '-day'">{% trans %}Move-out date{% endtrans %}</label>
			<date-picker v-model="moveOutDate" :id="uid('moveOutDate')" required></date-picker>
		</div>
	</template>
	<template v-if="stage === 'newAddress'">
		<h2>{% trans %}Your next address{% endtrans %}</h2>
		<p>{% trans %}Where will you live after you leave Germany?{% endtrans %}</p>
		<hr>
		<div class="form-group required">
			<label :for="uid('newAddress')">{% trans %}Street address{% endtrans %}</label>
			<input
				:id="uid('newAddress')"
				type="text"
				ref="newAddressInput"
				v-model="newAddress"
				placeholder="{% trans "Placeholder for the first line of a foreign street address" %}123 Maple Street, Apt. 102{% endtrans %}"
				autocomplete="address-line1"
				required>
		</div>
		<div class="form-group required">
			<label :for="uid('newCityAndPostCode')">
				{% trans %}City and post code{% endtrans %}
			</label>
			<input
				:id="uid('newCityAndPostCode')"
				placeholder="{% trans "Placeholder for a city, region and post code" %}Montreal, Quebec, H3E 1J4{% endtrans %}"
				type="text"
				v-model="newCityAndPostCode"
				autocomplete="address-level2" required>
		</div>
		<div class="form-group required">
			<label :for="uid('newCountry')">{% trans %}Country{% endtrans %}</label>
			<country-input
				country-code
				v-model="newCountry"
				ref="newCountryInput"
				:id="uid('newCountry')"
				required></country-input>
			<span v-if="newCountry === 'DE'" class="input-instructions">{% trans %}If you stay in Germany, you probably don't need to deregister your address{% endtrans %}&nbsp;&mdash;&nbsp;<a href="/guides/abmeldung-deregister-in-berlin#who-needs-to-deregister" target="_blank">{% trans %}More information{% endtrans %}</a></span>
		</div>
	</template>
	<template v-if="stage === 'addPeople'">
		<h2>{% trans %}Who is deregistering?{% endtrans %}</h2>
		<p>{% trans %}Enter the same information as on your <em><glossary term="Anmeldebestätigung">Anmeldebestätigung</glossary></em>.{% endtrans %}</p>
		<template v-for="(person, index) in people">
			<hr>
			<h3 v-if="people.length > 1">
				{% raw %}<i class="icon person"></i> {{ person.firstName ? `${person.title} ${person.firstName} ${person.lastName}` : `{% trans %}Person{% endtrans %} #${ index + 1 }` }}{% endraw %}
			</h3>
			<div class="form-group" v-if="person.showExtraFields">
				<label :for="uid('title') + person.id">{% trans "The title that goes before a name, like 'Dr'" %}Title{% endtrans %}</label>
				<input type="text"
					:id="uid('title') + person.id"
					v-model="person.title"
					autocomplete="honorific-prefix"
					placeholder="Dr." 
					class="anrede-input">
			</div>
			<div class="form-group required">
				<label :for="uid('firstName-' + person.id)">{% trans %}First and last name{% endtrans %}</label>
				<div class="input-group">
					<input type="text"
						:id="uid('firstName-' + person.id)"
						v-model="person.firstName"
						ref="firstNameInput"
						placeholder="{% trans "Example first name in the user's language" %}Alex{% endtrans %}"
						autocomplete="given-name"
						class="first-name-input"
						title="{% trans %}First name{% endtrans %}"
						required>
					<input type="text"
						v-model="person.lastName"
						placeholder="{% trans "Example last name in the user's language" %}Smith{% endtrans %}"
						autocomplete="family-name"
						class="last-name-input"
						title="{% trans %}Last name{% endtrans %}"
						required>
					<a class="input-instructions" href="#" v-if="!person.showExtraFields" @click.prevent="person.showExtraFields = true">{% trans %}Add a title or birth name{% endtrans %}</a>
				</div>
			</div>
			<div class="form-group" v-if="person.showExtraFields">
				<label :for="uid('birthName-' + person.id)">{% trans %}Name at birth{% endtrans %}</label>
				<input
					type="text"
					v-model="person.birthName"
					:id="uid('birthName-' + person.id)"
					:aria-describedby="uid('birthName-instructions-' + person.id)"
					placeholder="{% trans "Example full name in the user's language" %}Alex Gagnon{% endtrans %}">
				<span class="input-instructions" :id="uid('birthName-instructions-' + person.id)">{% trans %}If you changed your name, enter your full name at birth.{% endtrans %}</span>
			</div>
			<div class="form-group">
				<span class="label">Gender</span>
				<div class="input-group">
					<label class="checkbox">
						<input type="radio" :name="uid('gender-' + person.id)" v-model="person.gender" value="Männlich" required>
						{% trans %}Male{% endtrans %}
					</label>
					<label class="checkbox">
						<input type="radio" :name="uid('gender-' + person.id)" v-model="person.gender" value="Weiblich" required>
						{% trans %}Female{% endtrans %}
					</label>
					<label class="checkbox">
						<input type="radio" :name="uid('gender-' + person.id)" v-model="person.gender" value="Divers" required>
						{% trans "Other gender / Divers" %}Other{% endtrans %}
					</label>
				</div>
			</div>
			<div class="form-group required">
				<label :for="uid('nationality-' + person.id)">{% trans %}Nationality{% endtrans %}</label>
				<country-input
					country-code
					v-model="person.nationality"
					:id="uid('nationality-' + person.id)"
					required></country-input>
			</div>
			<div class="form-group required">
				<label :for="uid('religion-' + person.id)">Religion</label>
				<select required :id="uid('religion-' + person.id)" v-model="person.religion">
					<option value="Evangelische Kirche">{% trans %}Evangelical Church{% endtrans %}</option>
					<option value="Römisch-katholische Kirche">{% trans %}Roman Catholic Church{% endtrans %}</option>
					<option value="Jüdische Gemeinde">{% trans %}Jewish Community{% endtrans %}</option>
					<option value="Altkatholische Kirche">{% trans %}Old Catholic Church{% endtrans %}</option>
					<option value="Freireligiöse Gemeinden">{% trans %}Free Religious communities{% endtrans %}</option>
					<option disabled>──────────</option>
					<option value="Sonstiges, nicht kirchensteuerpflichtig">{% trans %}Other / No religion{% endtrans %}</option>
				</select>
			</div>
			<div class="form-group required">
				<label :for="uid('dateOfBirth-' + person.id) + '-day'">{% trans %}Date of birth{% endtrans %}</label>
				<date-picker
					:key="person.id"
					:id="uid('dateOfBirth-' + person.id)"
					v-model="person.dateOfBirth"
					autocomplete="bday"
					required></date-picker>
			</div>
			<div class="form-group required">
				<label :for="uid('birthPlace-' + person.id)">{% trans %}Place of birth{% endtrans %}</label>
				<input
					type="text"
					v-model="person.birthPlace"
					:id="uid('birthPlace-' + person.id)"
					:aria-describedby="uid('birthPlace-instructions-' + person.id)"
					placeholder="{% trans "Example city/region/country in the user's language" %}Montreal, Quebec, Canada{% endtrans %}"
					required>
				<span class="input-instructions" :id="uid('birthPlace-instructions-' + person.id)">{% trans %}The city, region and country where you were born.{% endtrans %}</span>
			</div>
		</template>
	</template>
	<template v-if="stage === 'offlineFinish'">
		<h2>You are almost done!</h2>
		<template v-if="peopleTriples.length > 1">
			<p>{% trans %}Print the forms, sign them, and bring them to your <em>Abmeldung</em> appointment.{% endtrans %}</p>
			<div class="collapsible-options">
				<button v-for="([person1, person2, person3], index) in peopleTriples" @click="generatePDF(person1, person2, person3)" :disabled="downloadInProgress">
					{% include "_css/icons/pdf.svg" %}
					{% raw %}
					<div>
						<h3>Download part {{ index + 1 }} of the form</h3>
						<p v-if="person1.firstName">For {{ person1.firstName }}<template v-if="person2 && !person3"> and {{ person2.firstName }}</template><template v-if="person2 && person3">, {{ person2.firstName }} and {{ person3.firstName }}</template>.</p>
					</div>
					{% endraw %}
				</button>
			</div>
		</template>
		<div class="collapsible-options">
			<button v-if="peopleTriples.length === 1" @click="generatePDF(people[0], people[1], people[2])" :disabled="downloadInProgress">
				{% include "_css/icons/pdf.svg" %}
				<div>
					<h3>{% trans %}Download the filled form{% endtrans %}</h3>
					<p>{% trans %}Print this form, sign it, then send it to the <em>Bürgeramt</em>.{% endtrans %}</p>
				</div>
			</button>
		</div>
		<h3>{% trans %}What to do next{% endtrans %}</h3>
		<p>{% trans %}To deregister your address, you must send this form to the Bürgeramt. You can do this by email, by post or in person.{% endtrans %}</p>
		<div class="collapsible-options">
			<a href="/guides/abmeldung-deregister-in-berlin#by-registered-mail" target="_blank">
				{% include "_css/icons/mail.svg" %}
				<div>
					<h3>{% trans %}Send the Abmeldung form{% endtrans %}</h3>
					<p>{% trans %}Deregister your address by post or by email. It's easier.{% endtrans %}</p>
				</div>
			</a>
			<a href="/guides/abmeldung-deregister-in-berlin#in-person-at-the-burgeramt" target="_blank">
				{% include "_css/icons/calendar.svg" %}
				<div>
					<h3>{% trans %}Book a Bürgeramt appointment{% endtrans %}</h3>
					<p>{% trans %}Deregister your address in person, get the deregistration certificate faster.{% endtrans %}</p>
				</div>
			</a>
			<a href="/out/deregistrationde-abmeldung" target="_blank">
				{% include "_css/icons/sendsomeone.svg" %}
				<div>
					<h3>{% trans %}Pay someone to deregister you{% endtrans %}</h3>
					<p>{% trans %}Pay someone to book your appointment, go to the Bürgeramt and do your Abmeldung. It's easier, and you get your deregistration certificate by email.{% endtrans %}</p>
				</div>
			</a>
			<a href="/donate" target="_blank">
				{% include "_css/icons/beers.svg" %}
				<div>
					<h3>{% trans %}Support this website{% endtrans %}</h3>
					<p>{% trans %}Donate a few euros to help me build more free tools.{% endtrans %}</p>
				</div>
			</a>
		</div>
	</template>
	<hr>
	<div class="buttons">
		<button v-if="stageIndex === 0" class="button primary" @click="stageIndex += 1">Start <i class="icon right" aria-hidden="true"></i></button>
		<button v-if="stageIndex > 0" class="button" @click="stageIndex -= 1"><i class="icon left" aria-hidden="true"></i> Go back</button>
		<button v-if="stage === 'addPeople'" class="button" @click="addPerson"><i class="icon person" aria-hidden="true"></i> Add another person</button>
		<button
			v-if="stageIndex > 0 && stageIndex < stages.length - 2"
			class="button primary"
			@click="nextStage">Continue <i class="icon right" aria-hidden="true"></i></button>
		<button v-if="stageIndex === stages.length - 2" class="button primary" @click="nextStage">Finish</button>
	</div>
</collapsible>
{% include '_js/countriesInGerman.js' %}
{% include '_js/letterUtils.js' %}
{% include '_js/pdf.js' %}
{% include '_js/vue.js' %}
{% include '_js/vue/collapsible.js' %}
{% include '_js/vue/country-input.js' %}
{% include '_js/vue/date-picker.js' %}
{% include '_js/vue/eur.js' %}
{% include '_js/vue/glossary.js' %}
{% include '_js/vue/postalcode-input.js' %}
{% include '_js/vue/preloadPDFMixin.js' %}
{% include '_js/vue/trackedStagesMixin.js' %}
{% include '_js/vue/uniqueIdsMixin.js' %}
{% js %}
	document.querySelectorAll('.abmeldung-form').forEach(
		el => new Vue({
			el: el,
			mixins: [uniqueIdsMixin, trackedStagesMixin, preloadPDFMixin],
			data() {
				return {
					trackAs: 'Abmeldung form',

					moveOutDate: '',
					oldAddress: '',
					oldBuildingDetails: '',
					oldPostCode: '',
					newAddress: '',
					newCityAndPostCode: '',
					newCountry: '',
					people: [],

					stages: [
						'start',
						'oldAddress',
						'newAddress',
						'addPeople',
						'offlineFinish',
					],
					stageIndex: 0,
					downloadInProgress: false,
					pdfUrl: '/documents/abmeldung-original.pdf',
				};
			},
			computed: {
				stage(){
					return this.stages[this.stageIndex];
				},
				peopleTriples(){
					// Split this.people in arrays of 3 people
					const peopleGroups = [];
					for(let i = 0; i < this.people.length / 3; i++){
						peopleGroups.push(this.people.slice(i*3, i*3 + 3));
					}
					return peopleGroups;
				},
			},
			methods: {
				nextStage(){
					if(validateForm(this.$el)){
						this.stageIndex += 1;
					}
				},
				addPerson(){
					this.people.push({
						id: Math.floor(Math.random() * 10000),
						title: '',
						firstName: '',
						lastName: '',
						birthName: '',
						nationality: '',
						religion: '',
						dateOfBirth: '',
						gender: '',
						birthPlace: '',
						showExtraFields: false,
					})
				},
				async generatePDF(person1, person2, person3){
					this.downloadInProgress = true;
					const textFields = {
						'Tag des Auszugs': formatDate(this.moveOutDate, 'de-DE'),
						'Postleitzahl Gemeinde Ortsteil bisherige Wohnung': mergeFields([
							this.oldPostCode,
							'Berlin'
						]),
						'Straße Hausnummer Zusätze bisherige Wohnung': mergeFields([
							this.oldAddress,
							this.oldBuildingDetails
						]),
						'Postleitzahl Gemeinde Kreis Land (falls Ausland: Staat) künftige Wohnung': mergeFields([
							this.newCityAndPostCode,
							countriesInGerman.all[this.newCountry]
						]),
						'Straße Hausnummer Zusätze künftige Wohnung': this.newAddress,
					};
					const checkboxFields = {
						'bisherige Wohnung war alleinige Wohnung': true,
						'nein': true,
						'künftige Wohunung wird alleinige Wohnung': true,
					};

					if(person1){
						textFields['Person 1 Familienname ggf Doktorgrad Zeile 1'] = mergeFields([
							person1.lastName,
							person1.title
						]);
						textFields['Person 1 Vornamen Rufnamen unterstreichen'] = person1.firstName;
						textFields['Person 1 Geburtsname'] = person1.birthName;
						textFields['Person 1 Geschlecht'] = person1.gender;
						textFields['Person 1 Tag Ort Land der Geburt'] = mergeFields([
							formatDate(person1.dateOfBirth, 'de-DE'),
							person1.birthPlace
						]);
						textFields['Person 1 Religionsgesellschaft'] = person1.religion;
						textFields['Person 1 Staatsangehörigkeiten'] = countriesInGerman.all[person1.nationality];
						textFields['Person 1 Ordens- Künstlername'] = person1.artistName;
					}

					if(person2){
						textFields['Person 2 Familienmitglied ist Familienname ggf Doktorgrad'] = mergeFields([
							person2.lastName,
							person2.title
						]);
						textFields['Person 2 Familienmitglied ist Vornamen Rufnamen unterstreichen'] = person2.firstName;
						textFields['Person 2 Familienmitglied ist Geburtsname'] = person2.birthName;
						textFields['Person 2 Familienmitglied istGeschlecht'] = person2.gender;
						textFields['Person 2 Familienmitglied ist Tag Ort Land der Geburt'] = mergeFields([
							formatDate(person2.dateOfBirth, 'de-DE'),
							person2.birthPlace
						]);
						textFields['Person 2 Familienmitglied ist Religionsgesellschaft'] = person2.religion;
						textFields['Person 2 Familienmitglied ist Staatsangehörigkeiten'] = countriesInGerman.all[person2.nationality];
						textFields['Person 2 Familienmitglied ist Ordens- Künstlername'] = person2.artistName;
					}

					if(person3){
						textFields['Person 3 Familienmitglied ist Familienname ggf Doktorgrad'] = mergeFields([
							person3.lastName,
							person3.title
						]);
						textFields['Person 3 Familienmitglied ist Vornamen Rufnamen unterstreichen'] = person3.firstName;
						textFields['Person 3 Familienmitglied ist Geburtsname'] = person3.birthName;
						textFields['Person 3 Familienmitglied ist Geschlecht'] = person3.gender;
						textFields['Person 3 Familienmitglied ist Tag Ort Land der Geburt'] = mergeFields([
							formatDate(person3.dateOfBirth, 'de-DE'),
							person3.birthPlace
						]);
						textFields['Person 3 Familienmitglied ist Religionsgesellschaft'] = person3.religion;
						textFields['Person 3 Familienmitglied istStaatsangehörigkeiten'] = countriesInGerman.all[person3.nationality];
						textFields['Person 3 Familienmitglied ist OrdensKünstlername'] = person3.artistName;
					}

					await pdf.fillAndSavePDF(this.pdfUrl, textFields, checkboxFields, null, 'abmeldung-form-filled.pdf', this.trackAs);
					this.downloadInProgress = false;
				},
			},
			watch: {
				async stageIndex(newStageIndex){
					Vue.nextTick(() => {
						const inputToFocus = {
							start: () => this.$refs.startButton,
							oldAddress: () => this.$refs.oldAddressInput,
							newAddress: () => this.$refs.newAddressInput,
							addPeople: () => this.$refs.firstNameInput[0],
							offlineFinish: () => null,
						}[this.stages[newStageIndex]]();

						if(inputToFocus){
							inputToFocus.focus();
						}
					});
				},
				oldPostCode(newVal) {
					const postalCodeIsValid = parseInt(newVal, 10) > 10100 && parseInt(newVal, 10) < 14200;
					try{
						this.$refs.oldPostCodeInput.$el.setCustomValidity(postalCodeIsValid ? '' : 'This is not a valid Berlin post code.');
					} catch (e) {}
				},
				newCountry(newVal) {
					try{
						this.$refs.newCountryInput.$el.setCustomValidity(newVal === 'DE' ? "You probably don't need to deregister." : '');
					} catch (e) {}
				},
			},
			created() {
				this.addPerson();
			}
		})
	);
{% endjs %}
