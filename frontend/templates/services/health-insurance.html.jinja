{% extends "services/_layout.html" %}
{% set metatitle = "Get German health insurance" %}
{% set metadescription = "Public, expat or private health insurance? Our insurance expert helps you choose the best German health insurance." %}

{% block main %}
	<main aria-label="Main page">
		<header class="section intro article-body">
			<h1>Health insurance? Sorted.</h1>
			<p>You need health insurance to live in Germany or apply for a German visa. We get you the right coverage for the best price.</p>
			<div class="buttons bar left">
				<a class="button primary" href="#calculator">Find health insurance</a>
				<a class="button" href="#contact">Ask our expert</a>
			</div>
		</header>
		<section class="section price-table" id="prices" aria-label="German health insurance prices">
			<p>In Germany, there is <a href="/glossary/Expat health insurance">expat</a>, <a href="/glossary/gesetzliche Krankenversicherung">public</a> and <a href="/glossary/private Krankenversicherung">private</a> health insurance. The best option depends on our situation. <a href="https://allaboutberlin.com/guides/german-health-insurance">Learn how health insurance works</a>, use our <a href="#calculator">recommendation tool</a> or <a href="#contact">ask our expert</a> to help you choose.</p>
			<hr>
			<table class="price-table">
				<thead>
					<tr class="plan-names">
						<th></th>
						<th scope="col">
							<glossary term="Expat health insurance">Expat</glossary>
						</th>
						<th scope="col">
							<glossary term="gesetzliche Krankenversicherung">Public</glossary>
						</th>
						<th scope="col">
							<glossary term="private Krankenversicherung">Private</glossary>
						</th>
					</tr>
					<tr class="price-and-description">
						<td></td>
						<td>
							<small>Basic coverage for your first visa.</small>
							<price :amount="200" per-month>From €200/month</price>
						</td>
						<td>
							<small>The simple, reliable long-term option.</small>
							<price :amount="200" per-month>From €200/month</price>
						</td>
						<td>
							<small>Custom coverage, faster healthcare.</small>
							<price :amount="200" per-month>From €200/month</price>
						</td>
					</tr>
				</thead>
				<tbody>
					<tr class="feature">
						<th scope="row">Cover your family for free</th>
						<td><span class="no"></span></td>
						<td><span class="yes"></span></td>
						<td><span class="no"></span></td>
					</tr>
					<tr class="feature">
						<th scope="row">Adjust what it covers</th>
						<td><span class="yes"></span></td>
						<td><span class="no"></span></td>
						<td><span class="yes"></span></td>
					</tr>
					<tr class="feature">
						<th scope="row">Switch to another option</th>
						<td></td>
						<td><span class="yes"></span></td>
						<td><span class="no"></span></td>
					</tr>
					<tr class="feature">
						<th scope="row">Cancellation period</th>
						<td></td>
						<td></td>
						<td></td>
					</tr>
				</tbody>
				<tbody>
					<tr class="section-heading">
						<th colspan="4">What it's good for</th>
					</tr>
					<tr class="feature">
						<th scope="row"><glossary term="Schengen visa">Schengen Visa</glossary></th>
						<td><span class="yes"></span></td>
						<td><span class="yes"></span></td>
						<td><span class="yes"></span></td>
					</tr>
					<tr class="feature">
						<th scope="row"><glossary>National Visa</glossary></th>
						<td><span class="yes"></span></td>
						<td><span class="yes"></span></td>
						<td><span class="yes"></span></td>
					</tr>
					<tr class="feature">
						<th scope="row"><glossary term="Aufenthaltstitel">Residence permit</glossary></th>
						<td><span class="yes"></span></td>
						<td><span class="yes"></span></td>
						<td><span class="yes"></span></td>
					</tr>
					<tr class="feature subfeature">
						<th scope="row">First application</th>
						<td><span class="no"></span></td>
						<td><span class="yes"></span></td>
						<td><span class="yes"></span></td>
					</tr>
					<tr class="feature subfeature">
						<th scope="row">Renewal</th>
						<td><span class="no"></span></td>
						<td><span class="yes"></span></td>
						<td><span class="yes"></span></td>
					</tr>
				</tbody>
			</table>
			<hr>
			<div class="buttons bar">
				<a href="#contact" class="button primary">Ask our expert</a>
				<a href="#calculator" class="button">Find the best option</a>
			</div>
		</section>
		{% tool "health-insurance-calculator", static=True, id="calculator" %}
		{% tool "health-insurance-calculator", mode="question", static=True, id="contact" %}
		<section class="section transparent">
			<h2 align="center">Why get insured with us?</h2>
			<div class="two-columns">
				<div>
					<h3>Perfect for your German visa</h3>
					<p>Our health insurance is accepted by German embassies, consulates and immigration offices. It works for any type of visa.</p>
				</div>
				<div>
					<h3>Get more, pay less</h3>
					<p>Are you paying too much for health insurance? We help you get better coverage at a lower price, for free.</p>
				</div>
				<div>
					<h3>We're on your side</h3>
					<p>We are independent brokers. We give honest, neutral advice, and we only sell you something when you need it.</p>
				</div>
				<div>
					<h3>Truly personalised advice</h3>
					<p>When it comes to your future, we don't believe in "one size fits all". Each case is a conversation, and we're happy to talk.</p>
				</div>
			</div>
		</section>
	</main>
{% endblock %}

{% js %}
	import initializePriceTable from '/js/components/health-insurance-price-table.mjs';
	initializePriceTable();
{% endjs %}
