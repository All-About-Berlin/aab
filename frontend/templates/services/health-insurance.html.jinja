{% extends "services/_layout.html" %}
{% set metatitle = "Get German health insurance" %}
{% set metadescription = "Public, expat or private health insurance? Our insurance expert helps you choose the best German health insurance." %}

{% block main %}
	<main aria-label="Main page">
		<header class="section hero">
			<div class="intro-text">
				<h1>Choose German health insurance with confidence</h1>
				<p>We help you find the right coverage at the lowest price, without the guesswork.</p>
				<div class="buttons bar left">
					<a class="button" href="#calculator">See your options</a>
					<a class="button" href="#contact">Ask our expert</a>
				</div>
			</div>
			{% include "staticimages/services/health-insurance.svg" %}
		</header>
		{% tool "health-insurance-calculator", static=True, landing_page=True, id="calculator" %}
		{% tool "health-insurance-calculator", mode="question", static=True, landing_page=True, id="contact" %}
		<section class="section transparent">
			<h2 align="center">Why get insured with us?</h2>
			<div class="two-columns">
				<div>
					<h3>Perfect for any visa</h3>
					<p>Our health insurance is accepted by German embassies, consulates and immigration offices.</p>
					<h3>Get more, pay less</h3>
					<p>We help freelancers, students and high earners save thousands of euros per year on insurance.</p>
					<h3>Truly personalised advice</h3>
					<p>Talk to a real expert who advises and supports you at every step.</p>
				</div>
				{% include "staticimages/services/relax.svg" %}
			</div>
		</section>
		<section class="section" aria-label="German health insurance prices">
			{% tool "health-insurance-price-table" %}
			<div class="buttons bar">
				<a href="#calculator" class="button primary next">Calculate your price</a>
			</div>
		</section>
		<section class="section transparent" id="reviews">
			<h2 align="center">Reviews</h2>
			<figure class="review" itemscope itemtype="https://schema.org/Review">
				<blockquote itemprop="reviewBody">
					<p>Seamus was very open in answering any and every question I had, and explained everything in full detail so that I could make my decision with as many data points as possible.</p>
				</blockquote>
				<figcaption itemprop="author" itemscope itemtype="https://schema.org/Person">
					<span itemprop="name">Swan</span>
				</figcaption>
			</figure>
		</section>
	</main>
{% endblock %}
