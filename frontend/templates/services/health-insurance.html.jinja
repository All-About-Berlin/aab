{% extends "services/_layout.html" %}
{% set metatitle = entry.title %}
{% set metadescription = entry.description %}

{% block main %}
	<main aria-label="Main page">
		<header class="section intro article-body">
			<h1>{{ entry.intro_title }}</h1>
			<small>From €{{HEALTH_INSURANCE_MIN_COST|cur}} per month</small>
			<ul>
				<li class="list-yes">Valid for your visa application</li>
				<li class="list-yes">Digital, English-speaking support</li>
			</ul>
			<div class="buttons bar left">
				<a class="button primary" href="#calculator">Get insured</a>
				<a class="button" href="#contact">Talk to an expert</a>
			</div>
		</header>
		{% tool "health-insurance-calculator", static=True, id="calculator" %}
		{% tool "health-insurance-calculator", mode="question", static=True, id="contact" %}
	</main>
{% endblock %}
