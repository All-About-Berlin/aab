{% extends "services/_layout.html" %}
{% set metatitle = "" %}
{% set metadescription = "Guides for people who want to settle in Berlin. Information about getting a visa, finding a job, finding an apartment, and a lot more." %}

{% block postHead %}
	{{ super() }}
	<link rel="canonical" href="{{ SITE_URL }}/">
{% endblock %}
{% block main %}
	<main aria-label="Main page">
		<header class="intro">
			<h1>One less thing to worry about</h1>
			<p>
				Get peace of mind with the right insurance coverage.
			</p>
		</header>

		{% tool "insurance-checklist", static=True %}

		<section class="article-body">
			<h2>Why us?</h2>
			<ul>
				<li>
					<strong>Honest insurance advice, in English</strong>
					<br>
					Get the coverage you need, explained to you in your language.
				</li>
				<li>
					<strong>Made for immigrants</strong>
					<br>
					We've been helping immigrants settle in Berlin for {{ now.year - 2017 }} years.
				</li>
			</ul>
		</section>
	</main>
{% endblock %}
