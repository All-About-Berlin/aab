{% extends "services/_layout.html" %}
{% set metatitle = "Page not found" %}
{% set metadescription = "The page you are looking for does not exist." %}

{% block postHead %}
	<meta name="robots" content="noindex">
	{% queueJs %}
		window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) };
		plausible("404", { props: { path: document.location.pathname } });
	{% endQueueJs %}
{% endblock %}

{% block main %}
	<main aria-label="Main page">
		<header class="section intro">
			<h1>Page not found</h1>
			<p>Not what you expected? To report a problem, <a href="{{ SERVICES_SITE_URL }}/contact">contact us</a>.</p>
		</header>
	</main>
{% endblock %}
