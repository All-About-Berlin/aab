{% extends "_layout.html" %}
{% set metatitle = entry.title %}
{% set metadescription = entry.description %}
{% set collection = entry %}
{% set ogtype = 'website' %}


{% block postHead %}
	{{ super() }}
	<link rel="index" href="{{ SITE_URL }}/guides">
{% endblock %}

{% macro collectionItem(item, isSubitem=false) %}
	<li>
		<strong>
			{% if item.uri|default %}
				<a href="{{ entries[item.uri].url }}">{{ entries[item.uri].short_title|default(entries[item.uri].title) }}</a>
			{% else %}
				{{ item.title }}
			{% endif %}
		</strong>
		{% if item.uri|default %}
			<br>{{ entries[item.uri].description }}
		{% endif %}
		{% if item.entries|default %}
			<ul>
				{% for subItem in item.entries %}
					{{ collectionItem(subItem, true) }}
				{% endfor %}
			</ul>
		{% endif %}
	</li>
{% endmacro %}

{% block main %}
	<main aria-label="Main page">
		<header class="intro">
			<h1>{{ entry.title }}</h1>
			{% if entry.description %}<p>{{ entry.description }}</p>{% endif %}
		</header>
		<div class="section" aria-label="Guides in this collection">
			<div class="article-body">
			{% for item in collection.entries %}
				<h2>
					{% if item.uri|default %}
						<a title="{{ entries[item.uri].title }}" href="{{ entries[item.uri].url }}">{{ item.title }}</a>
					{% else %}
						{{ item.title }}
					{% endif %}
				</h2>
				{% if item.uri|default %}
					<p>{{ entries[item.uri].description }}</p>
				{% endif %}
				{% if item.entries|default %}
					<ul>
						{% for item in item.entries %}
							{{ collectionItem(item) }}
						{% endfor %}
					</ul>
				{% endif %}
			{% endfor %}
			</div>
			<hr>
			<nav class="previous-next">
				<a rel="index" href="/guides"><i class="icon left"></i> See all other guides</a>
			</nav>
		</div>
	</main>
{% endblock %}

{% block postFooter %}
	{{ super() }}
	<script type="application/ld+json">
		[{
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			"name": {{ entry.title|tojson }},
			"description": {{ entry.description|tojson }},
			"breadcrumb": {
				"@type": "BreadcrumbList",
				"itemListElement": [
					{
						"@type": "ListItem",
						"position": 1,
						"item": {
							"@id": "{{ SITE_URL }}/",
							"name": "Home"
						}
					},
					{
						"@type": "ListItem",
						"position": 2,
						"item": {
							"@id": "{{ SITE_URL }}/guides",
							"name": "Guides"
						}
					},
					{
						"@type": "ListItem",
						"position": 3,
						"item": {
							"@id": "{{ entry.url }}",
							"name": {{ entry.title|tojson }}
						}
					}
				]
			},
			"author": {
				"@type": "Person",
				"@id": "https://nicolasbouliane.com"
			},
			"publisher": {
				"@type": "Organization",
				"@id": "{{ SITE_URL }}/#organization"
			},
			"mainEntity": {
				"@type": "ItemList",
				"itemListElement": [
					{% set ns = namespace(pos=0) %}
					{% for item in collection.entries recursive %}
						{% if item.uri|default %}
							{% if ns.pos > 0 %},{% endif %}
							{% set ns.pos = ns.pos + 1 %}
							{
								"@type": "ListItem",
								"position": {{ ns.pos }},
								"name": {{ entries[item.uri].title|tojson }},
								"url": "{{ entries[item.uri].url }}"
							}
						{% endif %}
						{% if item.entries|default %}{{ loop(item.entries) }}{% endif %}
					{% endfor %}
				]
			}
		}]
	</script>
{% endblock %}
