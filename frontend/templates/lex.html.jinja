{% extends "_layout.html" %}
{% set metatitle = "Lex" %}
{% set metadescription = "Lex API" %}
{% include '_js/vue.js' %}
{% include '_js/vue-router.js' %}

{% js %}{% raw %}
	const LexView = {
		props: {
			"paragraphId": String,
			"sectionId": String,
			"subsectionId": String,
		},
		data() {
			return {
				law,
			}
		},
		template: `
			<article class="section">
				<div class="article-body">
					<h1 v-text="law.short_title"></h1>
					<small v-text="law.title"></small>
					<template :key="paragraph.uri" v-for="paragraph in law.paragraphs" v-if="!paragraphId || paragraph.id === paragraphId">
						<h2>{{ paragraph.name }} &mdash; {{ paragraph.title }}</h2>
						<div v-html="paragraph.text"></div>
					</template>
				</div>
			</div>
		`,
	};

	// Router
	const router = new VueRouter({
		base: '/lex/',
		mode: 'hash',
		routes: [
			{ path: '/:paragraphId?/:sectionId?/:subsectionId?', component: LexView, props: true },
		],
	});

	new Vue({
		el: document.getElementById('lex'),
		router,
	})
{% endraw %}{% endjs %}

{% block main %}
	<main id="lex">
		<router-view></router-view>
	</main>
	<style>
	</style>
