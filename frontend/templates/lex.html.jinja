    "doknr": "BJNR195010004",
    "date_built": "2025-10-11T21:55:01",
    "paragraphs": {
        "inhaltsubersicht": {
            "uri": "aufenthg/inhaltsubersicht",
            "id": "inhaltsubersicht",
            "name": "Inhalts\u00fcbersicht",
            "title": null,
            "repealed": false,
            "doknr": "BJNR195010004BJNE020067311",
            "text": null,
            "subsections": {},
