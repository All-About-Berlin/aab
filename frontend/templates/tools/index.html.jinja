{% extends "_layout.html" %}
{% set metatitle = "Tools, forms and document templates" %}
{% set metadescription = "Tools for German bureaucracy: translated forms, document templates, tax calculators, Bürgeramt appointment finder and more." %}
{% set metaimage = "/staticimages/tools.png" %}

{% block postHead %}
	{{ super() }}
	<link rel="canonical" href="{{ SITE_URL }}/tools">
{% endblock %}

{% macro preview(entry) %}
	{% if entry.url.startswith(SITE_URL + '/docs/') %}
		{% set id = random_id() %}
		<li class="document" aria-labelledby="h-doc-{{ id }}">
			<h3 id="h-doc-{{ id }}">
				<a rel="bookmark" href="{{ entry.url }}">{{ entry.english_term }}</a>
				<span lang="de">{{ entry.german_term }}</span>
			</h3>
			<p>{{ entry.description }}</p>
		</li>
	{% elif entry.url.startswith(SITE_URL + '/tools/') %}
		{% set id = random_id() %}
		<li aria-labelledby="h-tool-{{ id }}">
			<h3 id="h-tool-{{ id }}">
				<a title="{{ entry.title }}" rel="bookmark" href="{{ entry.url }}">{{ entry.short_title|default(entry.title) }}</a>
			</h3>
			<p>{{ entry.description }}</p>
		</li>
	{% endif %}
{% endmacro %}

{% block main %}
	<main aria-label="Main page">
		<article class="section">
			<h1>Tools, forms and document templates</h1>
			<div class="article-body">
				<p>These documents and tools make your life in Berlin easier.</p>
				{% for collection in get_entries('collections') %}
					{% if collection.type == 'tools' %}
						<h2 id="{{ collection.id }}">{{ collection.title }}</h2>
						<ol class="previews">
						{% for item in collection.entries %}
							{{ preview(entries[item.uri]) }}
						{% endfor %}
						</ol>
					{% endif %}
				{% endfor %}
			</div>
		</article>
	</main>
	<div class="sidebar" data-nosnippet aria-label="Tool categories">
		<nav class="table-of-contents no-print" aria-label="Tool categories">
			<h2>Categories</h2>
			<ol>
				{% for collection in get_entries('collections') | selectattr('type', 'equalto', 'tools') %}
					{% if collection.type == 'tools' %}
						<li><a href="#{{ collection.id }}">{{ collection.short_title|default(collection.title) }}</a></li>
					{% endif %}
				{% endfor %}
			</ol>
		</nav>
		<div id="floating-nav">
			<button class="button open-close" title="Show/hide table of contents"><i class="icon table-of-contents"></i></button>
		</div>
	</div>
{% endblock %}

{% js %}
	import initializeSidebar from '/js/components/sidebar.mjs';
	initializeSidebar();
{% endjs %}
