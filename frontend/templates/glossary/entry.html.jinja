{% extends "_layout.html" %}

{% set title = entry.title | default("Definition of \"" + entry.german_term + "\"") %}
{% set metatitle = title %}
{% set metadescription = entry.description | default("A definition of the term \"" + entry.german_term + "\", in plain English.") %}
{% set related_entries = entry.related_guides|default([]) %}

{% block postHead %}
	{{ super() }}
	<link rel="index" href="{{ SITE_URL }}/glossary">
{% endblock %}

{% block content %}
	<h1>{{ title }}</h1>
	{% include "_blocks/postMeta.html" %}
	<div class="article-body">
		{{ entry.body|render|safe }}
	</div>
{% endblock %}

{% block postcontent %}
	{% if related_entries %}
		<aside class="section no-print" id="related" aria-labelledby="h-using-this-term" data-nosnippet>
			<h2 id="h-using-this-term">Related guides</h2>
			{% with entries=related_entries, showDateUpdated=true %}
				{% include "_blocks/entryPreviews.html" %}
			{% endwith %}
		</aside>
	{% endif %}
{% endblock %}

{% block postFooter %}
	{{ super() }}
	<script type="application/ld+json">
		[
			{
				"@context": "https://schema.org",
				"@type": "DefinedTerm",
				"name": {{ entry.german_term|tojson }},
				"description": {{ metadescription|tojson }},
				"url": "{{ entry.url }}",
				"inDefinedTermSet": {
					"@type": "DefinedTermSet",
					"name": "Glossary",
					"url": "{{ SITE_URL }}/glossary"
				}
			},
			{
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				"itemListElement": [
					{
						"@type": "ListItem",
						"position": 1,
						"item": {
							"@id": "{{ SITE_URL }}/",
							"name": "Home"
						}
					},
					{
						"@type": "ListItem",
						"position": 2,
						"item": {
							"@id": "{{ SITE_URL }}/glossary",
							"name": "Glossary"
						}
					},
					{
						"@type": "ListItem",
						"position": 3,
						"item": {
							"@id": "{{ entry.url }}",
							"name": {{ entry.german_term|tojson }}
						}
					}
				]
			}
		]
	</script>
{% endblock %}
