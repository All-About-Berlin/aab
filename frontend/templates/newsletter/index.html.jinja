{% extends "_layout.html" %}
{% set metatitle = "Berlin monthly newsletter" %}
{% set metadescription = "Berlin news in English, useful tips for living in Berlin, and website updates, delivered straight to your inbox every month." %}
{% set metaimage = "/staticimages/newsletter.png" %}

{% block postHead %}
	{{ super() }}
	<link rel="canonical" href="{{ SITE_URL }}/newsletter">
{% endblock %}
{% block main %}
	<main aria-label="Main page">
		<header class="intro">
			<h1>Newsletter</h1>
			{% with text="Subscribe to our newsletter to get Berlin tips and updates once per month." %}
				{% include "_blocks/newsletterForm.html" %}
			{% endwith %}
		</header>
		<section class="section" aria-label="Previous emails">
			{% with entries=get_entries('newsletter', sort_by='date_created', reverse=True), showDatePosted=true %}
				{% include "_blocks/entryPreviews.html" %}
			{% endwith %}
		</section>
	</main>
{% endblock %}
