{% extends "_layout.html" %}
{% set metatitle = entry.title %}
{% set metadescription = entry.description %}
{% set related_entries = entry.related_guides|default([]) %}

{% block postHead %}
	{{ super() }}
	<link rel="index" href="{{ SITE_URL }}/docs">
{% endblock %}

{% block main %}
	<main aria-label="Main page">
		{% block precontent %}{% endblock %}
		<article class="section">
			<h1>{{ entry.title }}</h1>
			{% include "_blocks/postMeta.html" %}
			<div class="article-body glossary-links">
				{{ entry.body|render|safe }}
			</div>
		</article>

		{% with pageType='document' %}
			{% include "_blocks/footerDonationPrompt.html" %}
		{% endwith %}

		{% if related_entries|length %}
			<aside class="section" aria-labelledby="h-related-guides">
				<h2 id="h-related-guides">Related guides</h2>
				{% with entries=related_entries, showDateUpdated=true %}
					{% include "_blocks/entryPreviews.html" %}
				{% endwith %}
			</aside>
		{% endif %}

		{% include "_blocks/affiliateNotice.html" %}
	</main>

	{% with entry=entry, showRelatedEntriesLink=related_entries|length %}
		{% include "_blocks/sidebar.html" %}
	{% endwith %}
{% endblock %}

{% block postFooter %}
	{{ super() }}
	<script type="application/ld+json">
		[{
			"@context": "https://schema.org",
			"@type": "WebPage",
			"name": {{ entry.title|tojson }},
			"description": {{ entry.description|tojson }},
			"breadcrumb": {
				"@type": "BreadcrumbList",
				"itemListElement": [
					{
						"@type": "ListItem",
						"position": 1,
						"item": {
							"@id": "{{ SITE_URL }}/",
							"name": "Home"
						}
					},
					{
						"@type": "ListItem",
						"position": 2,
						"item": {
							"@id": "{{ SITE_URL }}/tools",
							"name": "Tools"
						}
					},
					{
						"@type": "ListItem",
						"position": 3,
						"item": {
							"@id": "{{ entry.url }}",
							"name": {{ entry.title|tojson }}
						}
					}
				]
			},
			"author": {
				"@type": "Person",
				"@id": "https://nicolasbouliane.com"
			},
			"publisher": {
				"@type": "Organization",
				"@id": "{{ SITE_URL }}/#organization"
			},
			"speakable": {
				"@type": "SpeakableSpecification",
				"cssSelector": [".article-body"]
			},
			"dateModified": "{{ entry.date_updated.isoformat() }}",
			"datePublished": "{{ entry.date_created.isoformat() }}"
		}]
	</script>
{% endblock %}
