#!/usr/bin/env bash
# mise description="Create a new content entry. Usage: mise new <guide|tool|doc|glossary|newsletter> [title]"
set -e

SECTION="${1:-}"
TITLE="${2:-}"
DATE=$(date +%Y-%m-%d)
SUBLIME_PROJECT="/Users/nicolas/Documents/Projects/AllAboutBerlin/aab.sublime-project"

if [ -z "$SECTION" ]; then
  echo "Usage: mise new <guide|tool|doc|document|glossary|term|newsletter> [title]"
  exit 1
fi

if [ "$SECTION" = "document" ]; then
  SECTION="doc"
fi

if [ "$SECTION" = "term" ]; then
  SECTION="glossary"
fi

case "$SECTION" in
  guide)      DIR="frontend/content/guides" ;;
  tool)       DIR="frontend/content/tools" ;;
  doc)        DIR="frontend/content/docs" ;;
  glossary)   DIR="frontend/content/glossary" ;;
  newsletter) DIR="frontend/content/newsletter" ;;
  *)
    echo "Unknown section: '$SECTION'. Use: guide, tool, doc, document, glossary, term, newsletter"
    exit 1
    ;;
esac

TEMPLATE="frontend/content/_templates/${SECTION}.md"

if [ "$SECTION" = "newsletter" ]; then
  SLUG="${TITLE:-$(date -v+1m +%B-%Y | tr '[:upper:]' '[:lower:]')}"
  OUTPUT="${DIR}/_${SLUG}.md"
else
  SLUG="${TITLE:-$DATE}"
  OUTPUT="${DIR}/${SLUG}.md"
fi

if [ ! -f "$TEMPLATE" ]; then
  echo "Template not found: $TEMPLATE"
  exit 1
fi

if [ -f "$OUTPUT" ]; then
  echo "File already exists: $OUTPUT"
  exit 1
fi

mkdir -p "$(dirname "$OUTPUT")"
sed "s/{{date}}/$DATE/g" "$TEMPLATE" > "$OUTPUT"
echo "Created: $OUTPUT"
subl --project "$SUBLIME_PROJECT" --add "$OUTPUT"
